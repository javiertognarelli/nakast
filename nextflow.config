/*
 * -------------------------------------------------
 * Nextflow config file for NAKAST
 * -------------------------------------------------
 */

// 1. DEFAULT PARAMETERS
// Override any of these on the command line with --paramName value.
params {
    // Input / output
    samplesheet = "samplesheet.tsv"
    outdir      = "results"

    // Analysis parameters (Oxford Nanopore)
    nano_base_quality     = 20  // Phred 20, ~99% base accuracy
    
    // General options
    publish_dir_mode      = 'copy' // 'copy', 'symlink', 'link'

    // Whether a PubMLST API key is in the Nextflow secrets store. Only the
    // boolean is kept here, never the key; nakast.nf uses it to fail early.
    pubmlst_key_found     = secrets.PUBMLST_API_KEY ? true : false

    // Timestamp for the execution reports; see section 5
    trace_timestamp       = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// 2. PROCESS CONFIGURATION
process {
    
    // --- Default error strategy ---
    // A failing sample is skipped and the batch continues. Processes whose
    // failure would invalidate the whole run override this individually.
    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'ignore' }
    maxRetries    = 2
    
    // --- Default resources, used when a process declares no label ---
    cpus   = 4
    memory = 6.GB
    time   = 4.h

    // --- Resources by label ---
    // Processes select a tier with, for example, label 'process_low'.
    withLabel: process_low {
        cpus   = 2
        memory = 4.GB
        time   = 2.h
    }
    withLabel: process_medium {
        cpus   = 6
        memory = 10.GB
        time   = 8.h
    }
    withLabel: process_high {
        cpus   = 12
        memory = 16.GB
        time   = 24.h
    }

    // --- Software provisioning ---
    // Declared per process with the `conda` directive in nakast.nf; no
    // container images are assigned here.
}

// 3. CONDA ENVIRONMENTS
// Enabled unconditionally. Each process declares its own pinned environment in
// nakast.nf; leaving this to a profile means that forgetting the flag silently
// runs every process against the host PATH, failing with exit 127.
// Note that keys inside the `conda {}` scope take no 'conda.' prefix: written
// as `conda.enabled` they resolve to 'conda.conda.enabled' and are ignored.
conda {
    enabled       = true
    useMamba      = true
    cacheDir      = env('HOME') + "/.nextflow/conda"
    createTimeout = '2h'
}

// 4. PROFILES
profiles {

    // Default profile: local executor
    standard {
        process.executor = 'local'
    }

    // Kept for backwards compatibility. Conda is on by default, so this is
    // redundant, but `-profile conda` must not error for existing scripts.
    conda {
        conda.enabled = true
    }

    // Escape hatch: use the tools on the host PATH instead of Conda.
    host {
        conda.enabled = false
    }
}

// 5. EXECUTION REPORTS
// The timestamp lives in params rather than a `def`: Nextflow 26's strict
// config syntax rejects variable declarations ("Variable declarations cannot
// be mixed with config statements"). This form works on both 25.10 and 26.x.
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_timestamp}.txt"
}
