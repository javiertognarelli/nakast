/*
 * -------------------------------------------------
 * Nextflow config file for Hybrid Pipeline
 * -------------------------------------------------
 */

// 1. PARÁMETROS POR DEFECTO
// Estos valores se pueden sobreescribir al ejecutar con --paramName valor
params {
    // Entradas/Salidas
    samplesheet = "samplesheet.tsv"
    outdir      = "results"

    // Parámetros de Análisis (Illumina/Nanopore)
    illumina_base_quality = 30
    nano_base_quality     = 15  // Q-score 10 (aprox 90% accuracy)
    
    // Opciones generales
    publish_dir_mode      = 'copy' // 'copy', 'symlink', 'link'
}

// 2. CONFIGURACIÓN DE PROCESOS
process {
    
    // --- Estrategia de Errores General ---
    // Si una muestra falla, la ignora y sigue con las demás.
    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'ignore' }
    maxRetries    = 2
    
    // --- Recursos por defecto (si no se especifica etiqueta) ---
    cpus   = 4
    memory = 6.GB
    time   = 4.h

    // --- Definición de Recursos por Etiquetas (Labels) ---
    // En tu main.nf usarás: label 'process_low'
    withLabel: process_low {
        cpus   = 2
        memory = 4.GB
        time   = 2.h
    }
    withLabel: process_medium {
        cpus   = 6
        memory = 12.GB
        time   = 8.h
    }
    withLabel: process_high {
        cpus   = 12
        memory = 32.GB
        time   = 24.h
    }

    // --- Asignación de Contenedores y Configuración Específica ---
    
    // NANOPORE: Concatenación (Bash básico)
    withName: 'concat_ONT_fastq' {
        label 'process_low'
        // Usamos una imagen ligera de linux (alpine o ubuntu)
        container = 'ubuntu:20.04' 
    }

    // NANOPORE: Filtrado (NanoFilt)
    withName: 'FILTER_ONT' {
        label 'process_medium'
        // Contenedor oficial de NanoFilt desde BioContainers
        container = 'quay.io/biocontainers/nanofilt:2.8.0--py_0'
    }

    // NANOPORE: QC Visual (NanoPlot)
    withName: 'NANOPLOT' {
        label 'process_medium'
        container = 'quay.io/biocontainers/nanoplot:1.41.0--pyhdfd78af_0'
    }

    // ILLUMINA: Trimming (BBDuk)
    withName: 'process_trimming' {
        label 'process_medium'
        // BBDuk es parte de BBMap
        container = 'quay.io/biocontainers/bbmap:39.01--h5c4e2a8_0'
        // Aumentamos memoria dinámicamente si falla
        memory = { 8.GB * task.attempt }
    }
    
    // ALINEAMIENTO (Minimap2 - Ejemplo futuro)
    withName: 'process_alignment_minimap2' {
        label 'process_high'
        container = 'quay.io/biocontainers/minimap2:2.24--h7132678_1'
    }
}

// 3. PERFILES (Profiles)
// Te permite elegir dónde correr: local, docker o apptainer
profiles {
    
    // Perfil estándar (local, asume herramientas instaladas)
    standard {
        process.executor = 'local'
    }
}

// 4. REPORTES E INTROSPECCIÓN
// Genera archivos HTML útiles al terminar
def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}